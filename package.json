{
  "name": "gym-log",
  "version": "1.0.0",
  "private": true,
  "description": "Offline workout tracker for Android",
  "scripts": {
    "serve": "python3 -m http.server 8000 --directory www",
    "sync": "cap sync android",
    "icons": "capacitor-assets generate --android",
    "build:apk": "cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
